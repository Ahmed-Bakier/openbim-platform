# =============================================================================
*.ifc
*.ifczip
*.ifcxml
*.bcf
*.bcfzip
*.rvt
*.rfa
*.nwd
*.nwc
*.nwf
!tests/fixtures/**/*.ifc
!tests/fixtures/**/*.ifczip
!tests/fixtures/**/*.bcf
!tests/fixtures/**/*.bcfzip

# Local object-storage / upload data
/data/
/uploads/
/storage/
/minio-data/

