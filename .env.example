# -----------------------------------------------------------------------------
# Example environment configuration.
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is git-ignored. NEVER put real production credentials in this file.
# All values below are local-development placeholders.
# Variables are consumed starting in Milestone 1; names may still change.
# -----------------------------------------------------------------------------

# General
APP_ENV=development              # development | test | production
LOG_LEVEL=INFO

# Backend API (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-local-dev-only   # generate a real one: python -c "import secrets; print(secrets.token_urlsafe(64))"
API_CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js) — NEXT_PUBLIC_* values are exposed to the browser; never put secrets here
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openbim
POSTGRES_USER=openbim
POSTGRES_PASSWORD=openbim-local-dev
DATABASE_URL=postgresql+psycopg://openbim:openbim-local-dev@localhost:5432/openbim

# Redis (background jobs broker — final choice recorded in an ADR in Milestone 1)
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (local dev service chosen in Milestone 1)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-dev-access-key
S3_SECRET_ACCESS_KEY=local-dev-secret-key
S3_BUCKET_MODELS=openbim-models
S3_BUCKET_ATTACHMENTS=openbim-attachments
