# -----------------------------------------------------------------------------
# Example environment configuration.
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is git-ignored. NEVER put real production credentials in this file.
# All values below are local-development placeholders.
# Keep comments on their own lines: some tools do not support inline comments.
# -----------------------------------------------------------------------------

# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend API (FastAPI). Comma-separated list of allowed browser origins.
API_CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js). NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
# never put secrets in them.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL (used by infra/compose.yaml and the API)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openbim
POSTGRES_USER=openbim
POSTGRES_PASSWORD=openbim-local-dev
DATABASE_URL=postgresql+psycopg://openbim:openbim-local-dev@localhost:5432/openbim
# Separate database used by `make test` (created automatically by infra/compose.yaml)
TEST_DATABASE_URL=postgresql+psycopg://openbim:openbim-local-dev@localhost:5432/openbim_test

# Not used yet. Added when the milestone that needs them begins:
# - API_SECRET_KEY            (Milestone 3, authentication)
# - S3_* object storage       (Milestone 5/6, attachments and IFC files) — see ADR-0004
# - background job broker     (Milestone 6) — see ADR-0003
